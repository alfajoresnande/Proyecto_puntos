{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), camera=(), microphone=(), usb=(), magnetometer=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://accounts.google.com https://sdk.mercadopago.com https://*.mercadopago.com https://*.mlstatic.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://nandengineer.shop https://maps.geoapify.com https://via.placeholder.com https://*.mlstatic.com https://*.mercadopago.com; font-src 'self' data:; connect-src 'self' https://nandengineer.shop wss://nandengineer.shop https://api.geoapify.com https://accounts.google.com https://api.mercadopago.com https://*.mercadopago.com https://*.mercadolibre.com; frame-src https://accounts.google.com https://www.openstreetmap.org https://*.mercadopago.com https://*.mercadolibre.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.alfajorescorrentinos.com"
        }
      ],
      "destination": "https://alfajorescorrentinos.com/:path*",
      "permanent": true
    },
    {
      "source": "/inicio",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/tienda.html",
      "destination": "/tienda",
      "permanent": true
    },
    {
      "source": "/catalogo.html",
      "destination": "/catalogo",
      "permanent": true
    },
    {
      "source": "/sobre-nosotros.html",
      "destination": "/sobre-nosotros",
      "permanent": true
    },
    {
      "source": "/terminos.html",
      "destination": "/terminos",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/tienda",
      "destination": "/tienda.html"
    },
    {
      "source": "/catalogo",
      "destination": "/catalogo.html"
    },
    {
      "source": "/sobre-nosotros",
      "destination": "/sobre-nosotros.html"
    },
    {
      "source": "/terminos",
      "destination": "/terminos.html"
    },
    {
      "source": "/api/:path*",
      "destination": "https://nandengineer.shop/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://nandengineer.shop/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/app.html"
    }
  ]
}
