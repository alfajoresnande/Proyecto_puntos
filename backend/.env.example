# Plantilla de variables del backend. Copiar a backend/.env y completar.
# NUNCA commitear el .env real ni pegar secretos en este archivo.
#
# Generar un secreto:  npm run gen-secret --prefix backend

# ── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
TRUST_PROXY=1

# ── Auth: JWT ──────────────────────────────────────────────────────────────
# Minimo 64 caracteres. Rotarlo invalida todas las sesiones abiertas.
JWT_SECRET=
# Fijos en el token; cambiarlos invalida los JWT existentes.
JWT_ISSUER=nande-puntos-api
JWT_AUDIENCE=nande-puntos-web

# ── Auth: cookie de sesion ─────────────────────────────────────────────────
# El nombre por defecto es `__Host-auth_token` cuando la cookie es Secure, y
# `auth_token` en desarrollo sobre http. Definir AUTH_COOKIE_NAME solo si hay
# un motivo concreto: el default ya es el endurecido.
# AUTH_COOKIE_NAME=
#
# En produccion Secure es obligatorio: el arranque aborta si esta en false.
AUTH_COOKIE_SECURE=false
#
# IMPORTANTE (despliegue actual): el frontend vive en alfajorescorrentinos.com
# y la API en nandengineer.shop, dominios registrables distintos. Eso es
# cross-site, y una cookie SameSite=Lax NO se envia en ese caso.
#   - Mismo sitio (API en api.alfajorescorrentinos.com): usar `lax`.
#   - Sitios distintos (situacion actual):                usar `none` + Secure.
# Ver docs/seguridad-cookies-sesion.md antes de cambiarlo.
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_MAX_AGE_MS=604800000

# Clave propia para firmar la cookie `device_id`, separada de JWT_SECRET.
# Si falta, se deriva una con HKDF desde JWT_SECRET y se avisa en el log.
DEVICE_COOKIE_SECRET=

# Clave para firmar el token CSRF. Si falta, se usa JWT_SECRET.
CSRF_SECRET=

# ── Bootstrap administrativo (uso puntual, no dejar seteado) ───────────────
# Ver docs/seguridad-credenciales.md
# ADMIN_BOOTSTRAP_EMAIL=
# ADMIN_BOOTSTRAP_PASSWORD=
# ADMIN_BOOTSTRAP_NOMBRE=Administrador
# ADMIN_BOOTSTRAP_ROL=superAdmin

# ── Google OAuth ───────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=

# ── MySQL ──────────────────────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_DATABASE=nande_puntos
MYSQL_USER=
MYSQL_PASSWORD=
# off | required | verify-ca
MYSQL_SSL_MODE=off

# ── Readiness ──────────────────────────────────────────────────────────────
# Timeout del chequeo de MySQL en GET /api/ready (devuelve 503 si falla).
READINESS_DB_TIMEOUT_MS=1500

# ── Password reset / email ─────────────────────────────────────────────────
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
FRONTEND_RESET_PASSWORD_URL=http://localhost:5173/reset-password
# RESEND_API_KEY=
# RESEND_FROM=
# RESEND_REPLY_TO=

# ── Pagos: Mercado Pago ────────────────────────────────────────────────────
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_API_BASE=https://api.mercadopago.com
# MERCADOPAGO_WEBHOOK_URL=
#
# OBLIGATORIO para aceptar webhooks: sin este secreto toda notificacion
# firmada se rechaza con 401.
# MERCADOPAGO_WEBHOOK_SECRET=
#
# Cuenta vendedora esperada (collector_id). Si se define, un pago cobrado por
# otra cuenta se rechaza. Muy recomendado.
# MERCADOPAGO_COLLECTOR_ID=
#
# Ventana de frescura del `ts` firmado, en segundos. 0 la desactiva.
MERCADOPAGO_WEBHOOK_TOLERANCE_SECONDS=900
#
# Mercado Pago no firma las notificaciones de Orders QR; su autenticidad sale
# de consultar la API con nuestro access token. Poner en false para exigir
# firma tambien ahi (rompe el flujo QR).
MERCADOPAGO_QR_WEBHOOK_SIN_FIRMA=true
#
# Moneda esperada de las compras.
PAYMENTS_CURRENCY=ARS

# ── URLs de retorno del pago ───────────────────────────────────────────────
PAYMENT_RETURN_SUCCESS_URL=http://localhost:5173/cliente
PAYMENT_RETURN_PENDING_URL=http://localhost:5173/cliente
PAYMENT_RETURN_FAILURE_URL=http://localhost:5173/cliente

# ── Reservas de checkout ───────────────────────────────────────────────────
CHECKOUT_RESERVATION_MINUTES=15
RESERVATION_EXPIRATION_INTERVAL_MS=60000

# ── Diagnostico ────────────────────────────────────────────────────────────
DIAGNOSTICO_REQUIRE_AUTH=true
DIAGNOSTICO_PUBLIC=false
DIAGNOSTICO_TOKEN=
DIAGNOSTICO_DB_TIMEOUT_MS=1500

# ── Backups ────────────────────────────────────────────────────────────────
BACKUP_OUTPUT_DIR=./backups
BACKUP_KEEP_FILES=7

# ── Chatbot (Groq) ─────────────────────────────────────────────────────────
# Las 6 claves rotan solas: el router deja en cooldown la que da 429/401.
GROQ_API_KEY_PRIMARY=
GROQ_API_KEY_SECONDARY=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_API_KEY_6=
# Modelo. Vacio = openai/gpt-oss-20b. Groq apago llama-3.1-8b-instant el
# 16/08/2026; si vuelve a deprecar uno, se cambia aca sin redeployar.
# Lista viva: https://console.groq.com/docs/models
GROQ_MODEL=
# gpt-oss razona antes de responder y esos tokens salen del mismo presupuesto
# que la respuesta. none|low|medium|high (default: low).
AI_CHAT_REASONING_EFFORT=
AI_CHAT_MAX_OUTPUT_TOKENS=700
