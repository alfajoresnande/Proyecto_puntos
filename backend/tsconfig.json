{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,

  },
  "include": ["./**/*.ts"],
  // Los tests corren con vitest (ESM); no se compilan a dist/.
  "exclude": ["node_modules", "dist", "src/__tests__", "vitest.config.mts"]
}
