# Plantilla para docker-compose.yml (desarrollo local).
#
# Copiar a `.env` y completar con valores propios. NO hay valores por defecto:
# `docker compose up` falla si falta alguno. Generar claves con:
#
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"

MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=nande_puntos
MYSQL_USER=
MYSQL_PASSWORD=

# Puertos publicados. El compose los ata a 127.0.0.1.
MYSQL_HOST_PORT=3307
PMA_PORT=8080
